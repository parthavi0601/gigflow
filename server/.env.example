PORT=5000

# Local MongoDB (run: docker compose up mongo -d)
MONGO_URI=mongodb://127.0.0.1:27017/gigflow

# MongoDB Atlas (whitelist your IP in Atlas → Network Access)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

JWT_SECRET=your_strong_random_jwt_secret_here
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Email Configuration (Required for OTP in Production Mode)
# Generate a Google App Password here: https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_digit_app_password

# Mail (Resend)
RESEND_API_KEY=your_resend_key
SENDER_EMAIL=your_verified_domain_email

# AI
OPENAI_API_KEY=your_openai_key
