# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment Variables (NEVER commit real secrets) ─────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
# Allow example/template files
!.env.example
!.env.*.example

# ── Build Outputs ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
*.local

# ── Package Manager ───────────────────────────────────────────────────────────
.yarn/
!.yarn/releases
!.yarn/plugins
.pnp.*

# ── Docker ────────────────────────────────────────────────────────────────────
